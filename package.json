{
   "name": "portfolio",
   "version": "1.0.0",
   "private": true,
   "description": "Personal portfolio — HTML, SCSS, JavaScript",
   "scripts": {
      "build:css": "sass styles/scss/main.scss styles/css/main.css --style=expanded",
      "watch:css": "sass --watch styles/scss/main.scss:styles/css/main.css --style=expanded",
      "start": "serve . -l 8080",
      "dev": "concurrently -n sass,server -c yellow,cyan \"npm run watch:css\" \"npm run start\"",
      "build": "npm run build:css"
   },
   "devDependencies": {
      "concurrently": "^9.1.2",
      "sass": "^1.87.0",
      "serve": "^14.2.4"
   }
}
